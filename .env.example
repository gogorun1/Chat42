POSTGRES_USER=chat42
POSTGRES_PASSWORD=changeme
POSTGRES_DB=chat42

# Run `id -u` and `id -g` and put the results here so containers create
# files owned by you instead of a mismatched UID/GID (defaults to 1001/1001
# if unset). Only matters on Linux hosts.
HOST_UID=1001
HOST_GID=1001

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=changeme

# From https://profile.intra.42.fr/oauth/applications/new (UID / Secret shown after submit)
FT_CLIENT_ID=changeme
FT_CLIENT_SECRET=changeme
FT_REDIRECT_URI=https://localhost/auth/42/callback
